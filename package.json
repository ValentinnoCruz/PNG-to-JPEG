{
  "name": "png-to-jpeg-metadata-converter",
  "version": "4.10.0",
  "description": "Offline PNG to JPEG converter with real JPEG template emulation plus safe project metadata viewer/bulk editor. v4.8 redesigns the Editor tab as a Browse / Edit / Inspect mode switcher with a preview rail, smart column picker, and double-click-to-edit row interaction.",
  "main": "main.js",
  "author": "Val Cruz",
  "scripts": {
    "start": "electron .",
    "fetch-tools": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/fetch-tools.ps1",
    "dist": "npm run fetch-tools && electron-builder --win nsis",
    "dist:nofetch": "electron-builder --win nsis",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.valcruz.pngjpegmetadata.v4_10",
    "productName": "PNG2JPEG",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "styles.css",
      "exiftool_config",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "tools",
        "to": "tools",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "exiftool_config",
        "to": "exiftool_config"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PNG2JPEG"
    }
  }
}